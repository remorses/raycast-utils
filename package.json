{
  "name": "@termcast/utils",
  "version": "2.2.2",
  "description": "Set of utilities to streamline building Raycast extensions",
  "author": "Raycast Technologies Ltd.",
  "homepage": "https://developers.raycast.com/utilities/getting-started",
  "type": "module",
  "source": "src/index.ts",
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./src/index.ts"
    }
  },
  "scripts": {
    "lint": "eslint src/",
    "test": "npm run lint"
  },
  "peerDependencies": {
    "@raycast/api": ">=1.104.1",
    "react": ">=19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "keywords": [
    "Raycast",
    "utilities",
    "extensions"
  ],
  "files": [
    "src",
    "README.md"
  ],
  "license": "MIT",
  "dependencies": {
    "dequal": "^2.0.3"
  },
  "devDependencies": {
    "@parcel/packager-ts": "^2.16.0",
    "@parcel/transformer-typescript-types": "^2.16.0",
    "@raycast/api": "1.104.1",
    "@types/node": "25.0.6",
    "@typescript-eslint/eslint-plugin": "6.7.5",
    "@typescript-eslint/parser": "6.7.5",
    "eslint": "8.51.0",
    "eslint-config-prettier": "9.0.0",
    "eslint-plugin-import": "2.28.1",
    "eslint-plugin-jest": "27.4.2",
    "eslint-plugin-prettier": "5.0.0",
    "eslint-plugin-react-hooks": "4.6.0",
    "parcel": "^2.16.0",
    "typescript": "^5.9.3"
  }
}
